# The Node service calls Rank Ledger over HTTP. Keep the actual API key and webhook
# secret out of Git; these defaults only match the local Rank Ledger demo.
HOST=127.0.0.1
PORT=3000
RANK_LEDGER_BASE_URL=http://localhost:8080
RANK_LEDGER_API_KEY=local-demo-key-change-me
RANK_LEDGER_REQUEST_TIMEOUT_MS=5000
RANK_LEDGER_WEBHOOK_SECRET=local-development-webhook-secret
RANK_LEDGER_WEBHOOK_TOLERANCE_SECONDS=300
